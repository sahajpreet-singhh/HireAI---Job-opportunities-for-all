{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and role.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["seeker", "employer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Job": {
      "title": "Job Posting",
      "description": "A job opportunity posted by an employer.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "UID of the employer who posted the job." },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "companyName": { "type": "string" },
        "companyLogo": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "salary": { "type": "string" },
        "category": { "type": "string" },
        "aiMatchScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "description", "companyName", "createdAt"]
    },
    "Application": {
      "title": "Job Application",
      "description": "An application submitted by a seeker for a specific job.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "seekerId": { "type": "string", "description": "UID of the job seeker." },
        "employerId": { "type": "string", "description": "UID of the employer who owns the job." },
        "jobTitle": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "seekerId", "employerId", "status", "appliedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by their Firebase Auth UID."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job postings."
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Job applications."
    }
  }
}
